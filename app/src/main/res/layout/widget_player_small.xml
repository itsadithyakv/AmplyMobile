<?xml version="1.0" encoding="utf-8"?>
<!-- One-row widget (about 3x1 / 4x1): cover, title and controls, nothing else. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_amply_compact"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_art_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#FF231F1B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#FF544C43"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_previous"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_amply_previous"
        android:tint="#FF544C43" />

    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_widget_play"
        android:contentDescription="@string/widget_play_pause"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_amply_play"
        android:tint="#FF1C1610" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_next"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_amply_next"
        android:tint="#FF544C43" />
</LinearLayout>
